{
  "expo": {
    "name": "Sunday Drive",
    "slug": "sunday-drive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sunday-drive-mobile-icon.png",
    "scheme": "sunday-drive-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/sunday-drive-splash-wordmark.png",
      "imageWidth": 360,
      "resizeMode": "contain",
      "backgroundColor": "#202322",
      "dark": {
        "image": "./assets/images/sunday-drive-splash-wordmark.png",
        "backgroundColor": "#202322"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/sunday-drive-mobile-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sunday-drive-splash-wordmark.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "backgroundColor": "#202322",
          "dark": {
            "image": "./assets/images/sunday-drive-splash-wordmark.png",
            "backgroundColor": "#202322"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
